#!/usr/bin/env bash
set -Eeuo pipefail

# Production health check used by social.fischr.org. Besides process and HTTP
# health, this deliberately checks durable Bluesky state so a live server
# cannot hide an expired OAuth session or a stuck crosspost queue.

readonly SOCIAL_MONITORING_CONFIG="${SOCIAL_MONITORING_CONFIG:-/etc/social-stack-monitoring.conf}"
readonly GTS_DATABASE="${GTS_DATABASE:-/srv/gotosocial/sqlite.db}"
readonly BLUESKY_MAX_PENDING_MINUTES="${BLUESKY_MAX_PENDING_MINUTES:-15}"
readonly BLUESKY_MAX_SYNC_MINUTES="${BLUESKY_MAX_SYNC_MINUTES:-10}"
readonly BLUESKY_MAX_ERROR_MINUTES="${BLUESKY_MAX_ERROR_MINUTES:-10}"
readonly BLUESKY_ERROR_STATE_FILE="${BLUESKY_ERROR_STATE_FILE:-/run/social-stack-health-bluesky-error-since}"

if [[ -r "${SOCIAL_MONITORING_CONFIG}" ]]; then
  # shellcheck source=/dev/null
  source "${SOCIAL_MONITORING_CONFIG}"
fi

healthchecks_ping() {
  local url="${1:-}"
  local suffix="${2:-}"
  local body="${3:-}"
  [[ -n "${url}" ]] || return 0
  /usr/bin/curl --fail --silent --show-error --max-time 10 \
    --data-binary "${body}" "${url}${suffix}" >/dev/null 2>&1 || \
    /usr/bin/logger --tag social-stack-monitoring \
      "Could not deliver Healthchecks.io stack${suffix} ping"
}

diagnostic="Social stack health check failed."
failure_ping() {
  local status="$?"
  printf '%s\n' "${diagnostic}" >&2
  /usr/bin/logger --tag social-stack-health "${diagnostic}"
  healthchecks_ping "${HC_STACK_URL:-}" "/fail" "${diagnostic}"
  exit "${status}"
}
trap failure_ping ERR

check_container() {
  local container="$1" state health
  state="$(docker inspect --format '{{.State.Status}}' "${container}")"
  health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "${container}")"
  if [[ "${state}" != "running" || "${health}" != "healthy" ]]; then
    diagnostic="${container} is not healthy: state=${state}, health=${health}."
    return 1
  fi
}

check_bluesky() {
  local result auth_failures disconnected pending stale dead_deliveries dead_notifications stale_sync sync_errors sync_error_fingerprint
  result="$(sqlite3 -readonly -separator '|' "${GTS_DATABASE}" "
    SELECT
      (SELECT count(*) FROM bluesky_connections
       WHERE last_sync_error_code = 'auth'
          OR lower(last_sync_error) LIKE '%invalid_grant%'
          OR lower(last_sync_error) LIKE '%session expired%'
          OR lower(last_sync_error) LIKE '%invalid refresh token%'),
      (SELECT count(*) FROM bluesky_connections
       WHERE crosspost_public = 1
         AND (oauth_session_id IS NULL OR oauth_session_id = '' OR oauth_data IS NULL OR length(oauth_data) = 0)),
      (SELECT count(*) FROM bluesky_deliveries),
      (SELECT count(*) FROM bluesky_deliveries
       WHERE julianday(created_at) <= julianday('now', '-${BLUESKY_MAX_PENDING_MINUTES} minutes')),
      (SELECT count(*) FROM bluesky_deliveries WHERE dead_letter = 1),
      (SELECT count(*) FROM bluesky_notifications WHERE dead_letter = 1),
      (SELECT count(*) FROM bluesky_connections
       WHERE last_sync_error IS NOT NULL AND last_sync_error != ''),
      (SELECT count(*) FROM bluesky_connections
       WHERE oauth_session_id IS NOT NULL AND oauth_session_id != ''
         AND oauth_data IS NOT NULL AND length(oauth_data) > 0
         AND ((last_sync_at IS NULL AND julianday(updated_at) <= julianday('now', '-${BLUESKY_MAX_SYNC_MINUTES} minutes'))
           OR julianday(last_sync_at) <= julianday('now', '-${BLUESKY_MAX_SYNC_MINUTES} minutes'))),
      (SELECT coalesce(group_concat(hex(error_identity), ''), '')
       FROM (
         SELECT id || char(0) || coalesce(last_sync_error_code, '') || char(0) || last_sync_error AS error_identity
         FROM bluesky_connections
         WHERE last_sync_error IS NOT NULL AND last_sync_error != ''
         ORDER BY id
       ));
  ")"
  IFS='|' read -r auth_failures disconnected pending stale dead_deliveries dead_notifications sync_errors stale_sync sync_error_fingerprint <<<"${result}"
  if (( auth_failures > 0 )); then
    diagnostic="Bluesky sync authorization expired: reconnect required; ${pending} outgoing post(s) waiting."
    return 1
  fi
  if (( disconnected > 0 )); then
    diagnostic="Bluesky crossposting is enabled but ${disconnected} account(s) are disconnected; reconnect required; ${pending} outgoing post(s) waiting."
    return 1
  fi
  if (( dead_deliveries + dead_notifications > 0 )); then
    diagnostic="Bluesky sync has ${dead_deliveries} failed outgoing item(s) and ${dead_notifications} failed incoming item(s); ${pending} outgoing post(s) waiting."
    return 1
  fi
  if (( stale > 0 )); then
    diagnostic="Bluesky sync is stuck: ${stale} post(s) waiting longer than ${BLUESKY_MAX_PENDING_MINUTES} minutes (${pending} total)."
    return 1
  fi
  if (( stale_sync > 0 )); then
    diagnostic="Bluesky incoming sync scheduler is stale for ${stale_sync} account(s): no attempt for more than ${BLUESKY_MAX_SYNC_MINUTES} minutes."
    return 1
  fi
  if (( sync_errors > 0 )); then
    local now error_since stored_fingerprint state_tmp
    now="$(date +%s)"
    if [[ -r "${BLUESKY_ERROR_STATE_FILE}" ]]; then
      IFS='|' read -r error_since stored_fingerprint <"${BLUESKY_ERROR_STATE_FILE}" || true
    fi
    if [[ ! "${error_since:-}" =~ ^[0-9]+$ || "${stored_fingerprint:-}" != "${sync_error_fingerprint}" ]]; then
      error_since="${now}"
      state_tmp="${BLUESKY_ERROR_STATE_FILE}.tmp.$$"
      printf '%s|%s\n' "${error_since}" "${sync_error_fingerprint}" >"${state_tmp}"
      mv -f -- "${state_tmp}" "${BLUESKY_ERROR_STATE_FILE}"
    fi
    if (( now - error_since >= BLUESKY_MAX_ERROR_MINUTES * 60 )); then
      diagnostic="Bluesky incoming sync has failed continuously for more than ${BLUESKY_MAX_ERROR_MINUTES} minutes on ${sync_errors} account(s)."
      return 1
    fi
  else
    rm -f -- "${BLUESKY_ERROR_STATE_FILE}"
  fi
}

check_stack() {
  systemctl is-active --quiet gotosocial.service || { diagnostic="GoToSocial service is not active."; return 1; }
  check_container caddy
  check_container pds
  curl --fail --silent --show-error --max-time 15 https://social.fischr.org/api/v1/instance >/dev/null
  curl --fail --silent --show-error --max-time 15 https://pds.fischr.org/xrpc/_health >/dev/null
}

if [[ "${SOCIAL_STACK_HEALTH_BLUESKY_ONLY:-false}" != "true" ]]; then
  for attempt in 1 2 3; do
    if check_stack; then
      break
    fi
    if [[ "${attempt}" == "3" ]]; then
      false
    fi
    sleep 30
  done
fi

check_bluesky
healthchecks_ping "${HC_STACK_URL:-}" "" "Social stack and Bluesky sync are healthy."
trap - ERR
